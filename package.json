{
  "name": "@notross/mongo-singleton",
  "version": "3.0.2",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mongodb",
    "mongo",
    "database",
    "db",
    "singleton",
    "connection",
    "shared-connection",
    "connection-pool",
    "nodejs",
    "node",
    "typescript",
    "ts",
    "client",
    "wrapper",
    "utility",
    "reusable"
  ],
  "description": "Zero-config, plug-and-play MongoDB client management for Node.js: shared connections, multi-client support, Pino logging, and env/config-file resolution out of the box.",
  "license": "MIT",
  "author": {
    "name": "Ross Libby",
    "email": "dev@rosslibby.com",
    "url": "https://rosslibby.com",
    "github": "https://github.com/rosslibby"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosslibby/mongo-singleton.git"
  },
  "scripts": {
    "build": "tsup && yarn build:types",
    "build:types": "tsc --emitDeclarationOnly --noEmit false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx watch src/index.ts",
    "prepare": "yarn build"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "mongodb-memory-server": "^11.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "cosmiconfig": "^10.0.0",
    "mongodb": "^7.5.0",
    "pino": "^10.3.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  }
}
